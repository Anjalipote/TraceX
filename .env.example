# ==============================================================================
# TraceX Forensic Platform - Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# In production with reverse proxy / Nginx / Docker:
VITE_API_BASE_URL=/api

# For separate frontend / backend domain hosting (e.g., https://api.yourdomain.com/api):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_API_URL=https://api.yourdomain.com/api

# ------------------------------------------------------------------------------
# BACKEND & DATABASE CONFIGURATION (PostgreSQL REQUIRED in Production)
# ------------------------------------------------------------------------------
# Production PostgreSQL Connection:
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password@localhost:5432/tracex_db

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC SECURITY & JWT SECRETS (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-cryptographically-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# EVIDENCE STORAGE CONFIGURATION (Strictly inert, non-executable storage)
# ------------------------------------------------------------------------------
# Mount persistent external block storage / volume in production:
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# ------------------------------------------------------------------------------
# CORS SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Whitelist authorized frontend production domains (comma-separated or JSON list):
BACKEND_CORS_ORIGINS=["https://tracex.yourdomain.com","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# APPLICATION METADATA & INTEGRITY MONITORING
# ------------------------------------------------------------------------------
PROJECT_NAME="TraceX Forensic Platform"
ENVIRONMENT=production
AUTO_VERIFY_HASHES=true
AUDIT_LOG_RETENTION_DAYS=90
