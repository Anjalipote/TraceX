# ==============================================================================
# TraceX Forensic Platform - Backend Environment Configuration (Production)
# ==============================================================================

# Project Information
PROJECT_NAME="TraceX Forensic Platform"
TAGLINE="From Digital Evidence to Investigation Story"
VERSION="5.0.0"
ENVIRONMENT="production"

# Database Configuration (PostgreSQL REQUIRED in Production)
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/tracex_db
# For managed PostgreSQL (AWS RDS, Neon, Supabase, Render, Railway), provide:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Security & Cryptography
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Evidence Storage Configuration (Strictly inert, non-executable storage)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes

# CORS Configuration
# Comma-separated list or JSON array of authorized production frontend origins
BACKEND_CORS_ORIGINS=["https://tracex.yourdomain.com","http://localhost:5173","http://127.0.0.1:5173"]

# Audit Logging & Evidence Integrity
AUTO_VERIFY_HASHES=true
AUDIT_LOG_RETENTION_DAYS=90
